APP_ENV=development
DEBUG=true
DATABASE_PATH=data/mergescope.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
