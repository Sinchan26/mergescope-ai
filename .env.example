APP_ENV=development
DEBUG=true
DATABASE_PATH=data/mergescope.db
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=256
# GitHub App user OAuth (not a classic OAuth App). See docs/github-login.md.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
AUTH_ENCRYPTION_KEY=
APP_ORIGIN=http://localhost:5173
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/callback
AUTH_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
# Numeric GitHub IDs permitted to use this server's OpenAI key; empty denies all users.
ALLOWED_GITHUB_USER_IDS=
GITHUB_PUBLISHING_ENABLED=false
ALLOWED_REPOSITORIES=
REVIEW_POLICIES_PATH=config/review-policies.json
WORKER_ENABLED=false
WORKER_POLL_SECONDS=2
WORKER_MAX_ATTEMPTS=3
WORKER_LEASE_SECONDS=300
WEBHOOK_MAX_BYTES=1000000
DRY_RUN_ONLY=true
DEMO_MODE_ALLOWED=true
MAX_DIFF_CHARS=60000
MAX_DOCUMENT_BYTES=1000000
EVALUATION_DATASET_PATH=evaluations/cases.json
EVALUATION_RUN_TOKEN=
OPENAI_INPUT_COST_PER_MILLION=0
OPENAI_OUTPUT_COST_PER_MILLION=0
LOG_LEVEL=INFO
LOG_JSON=true
PROMPT_VERSION=phase4-v1
